{
    "configurations": [
        {
            "name": "Win32",
            "includePath":
            [
                "${workspaceFolder}/Application/Windows/Source/**",
                "${workspaceFolder}/Application/Windows/ThirdParty/**"
            ],
            "defines":
            [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "browse":
            {
                "path":
                [
                    "${workspaceFolder}/Application/Windows/Source/**",
                    "${workspaceFolder}/Application/Windows/ThirdParty/**",
                    "${workspaceFolder}/Application/Windows/node_modules/node-addon-api",
                    "${workspaceFolder}/Application/Windows/node_modules/node-api-headers/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "windowsSdkVersion": "10.0.26100.0",
            "compilerPath": "cl.exe",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}
