{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run electron-reactive-event Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/Package/ElectronReactiveEventExtension"]
    },
    {
        "name": "Electron: Main",
        "type": "node",
        "protocol": "inspector",
        "request": "launch",
        "cwd": "${workspaceFolder}/Application",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "start"],
        "env":
        {
            "MAIN_ARGS": "--inspect=5858 --remote-debugging-port=9223"
        }
    },
    {
      "name": "Electron: Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "${workspaceFolder}\\Application",
      "timeout": 30000
    }
  ],
  "compounds": [
    {
      "name": "Electron: All",
      "configurations": ["Electron: Main", "Electron: Renderer"]
    }
  ]
}
