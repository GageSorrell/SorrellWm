{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "FBox": {
            "allOf": [
                {
                    "properties": {
                        "X": {
                            "type": "number"
                        },
                        "Y": {
                            "type": "number"
                        }
                    },
                    "type": "object"
                },
                {
                    "properties": {
                        "Height": {
                            "type": "number"
                        },
                        "Width": {
                            "type": "number"
                        }
                    },
                    "type": "object"
                }
            ]
        },
        "FLogDigitSeparator": {
            "enum": [
                "Comma",
                "None",
                "Space",
                "Underscore"
            ],
            "type": "string"
        },
        "FLogQuoteStyle": {
            "enum": [
                "Double",
                "None",
                "Single"
            ],
            "type": "string"
        },
        "{Frontend:TArray<string>;Backend:TArray<string>;Native:TArray<string>;\"*\":TArray<string>;}": {
            "properties": {
                "*": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "Backend": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "Frontend": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "Native": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        }
    },
    "properties": {
        "CreateDummyWindows": {
            "description": "Spawn windows of various sizes at launch.",
            "properties": {
                "ConfigurationPath": {
                    "description": "Path to the JSON file of the configuration that should be used, relative to the `Application` directory.",
                    "pattern": "^\\./Dummy\\..*\\.json$",
                    "type": "string"
                },
                "Enabled": {
                    "type": "boolean"
                }
            },
            "type": "object"
        },
        "Log": {
            "properties": {
                "Category": {
                    "properties": {
                        "DisabledCategories": {
                            "$ref": "#/definitions/%7BFrontend%3ATArray%3Cstring%3E%3BBackend%3ATArray%3Cstring%3E%3BNative%3ATArray%3Cstring%3E%3B%22*%22%3ATArray%3Cstring%3E%3B%7D"
                        },
                        "LogDisabledCategoryAttempts": {
                            "type": "boolean"
                        }
                    },
                    "type": "object"
                },
                "Format": {
                    "properties": {
                        "AlwaysApplyFormat": {
                            "type": "boolean"
                        },
                        "Colors": {
                            "type": "boolean"
                        },
                        "DigitSeparator": {
                            "$ref": "#/definitions/FLogDigitSeparator"
                        },
                        "QuoteStyle": {
                            "$ref": "#/definitions/FLogQuoteStyle"
                        },
                        "TruncateBase64Strings": {
                            "type": "boolean"
                        }
                    },
                    "type": "object"
                },
                "Size": {
                    "properties": {
                        "LimitStatementLength": {
                            "properties": {
                                "Enabled": {
                                    "type": "boolean"
                                },
                                "MaxLength": {
                                    "type": "number"
                                }
                            },
                            "type": "object"
                        },
                        "MaxTerminalWidth": {
                            "type": "number"
                        },
                        "TabWidth": {
                            "type": "number"
                        }
                    },
                    "type": "object"
                }
            },
            "type": "object"
        },
        "SettingsWindow": {
            "properties": {
                "ShowOnLaunch": {
                    "properties": {
                        "Enabled": {
                            "type": "boolean"
                        },
                        "Position": {
                            "$ref": "#/definitions/FBox"
                        }
                    },
                    "type": "object"
                }
            },
            "type": "object"
        },
        "StaticMode": {
            "properties": {
                "Enabled": {
                    "type": "boolean"
                },
                "WindowShape": {
                    "$ref": "#/definitions/FBox"
                }
            },
            "type": "object"
        }
    },
    "type": "object"
}

