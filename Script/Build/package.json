{
  "name": "@sorrellwm/build",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The build tool for @sorrell/wm.",
  "main": "./Distribution/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"npm run watch-ts\" \"npm run watch-build-complete\"",
    "watch-ts": "tsc -w",
    "watch-build-complete": "nodemon --watch ./Distribution --exec \"node ./Distribution/index.js\"",
    "start": "node ./Distribution/index.js"
  },
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "license": "MIT",
  "devDependencies": {
        "@types/node": "^24.12.2",
    "chalk": "^5.3.0",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "ora": "^8.1.1",
    "typescript": "npm:tsover@^6.0.0"
  }
}
