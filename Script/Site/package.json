{
    "name": "@sorrell/site",
    "version": "1.0.0",
    "description": "Create and publish Sorrell Docusaurus and Storybook websites.",
    "private": true,
    "type": "module",
    "license": "MIT",
    "bin": { "sorrell-site": "./Distribution/index.js" },
    "exports":
    {
        ".":
        {
            "import": "./Distribution/index.js",
            "types": "./Distribution/index.d.ts"
        },
        "./Generator":
        {
            "import": "./Distribution/Generator.js",
            "types": "./Distribution/Generator.d.ts"
        },
        "./Publish":
        {
            "import": "./Distribution/Publish.js",
            "types": "./Distribution/Publish.d.ts"
        }
    },
    "files": [ "Distribution", "License.md", "ReadMe.md" ],
    "scripts":
    {
        "build": "tsc -p tsconfig.json",
        "lint": "eslint --config eslint.config.js \"Source/**/*.ts\" \"Test/**/*.ts\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
    },
    "dependencies":
    {
        "@aws-sdk/client-route-53": "3.1101.0",
        "@effect/platform-node": "4.0.0-beta.102",
        "@sorrell/site-core": "1.0.0",
        "@vercel/sdk": "1.28.15",
        "effect": "4.0.0-beta.102"
    },
    "devDependencies":
    {
        "@sorrell/tsconfig": "1.0.0",
        "@types/node": "26.1.1",
        "tsx": "4.23.1",
        "typescript": "6.0.2",
        "vitest": "4.1.10"
    },
    "engines":
    {
        "node": ">=26.6.0",
        "npm": ">=12.0.2"
    }
}
