{
    "compilerOptions": {
        "outDir": "./Distribution",
        "types": [ "node" ],
        "rootDir": "./Source",
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": false,
        "sourceMap": false,
        "declaration": false
    },
    "exclude": [ "Distribution", "node_modules" ],
    "include": [ "./Source/yarn.config.cts" ]
}
