{
  "name": "ts-tag-cli",
  "version": "1.0.3",
  "private": false,
  "description": "The CLI for ts-tag.",
  "files": [
    "./package.json",
    "./Distribution",
    "./Distribution/**/*",
    "./License.md",
    "./ReadMe.md",
    "./Resource/ts-tag.schema.json"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "build:schema": "typescript-json-schema ./tsconfig.JsonSchema.json FCliConfigSchema --out ./Resource/ts-tag.schema.json"
  },
  "bin": {
    "ts-tag": "./Distribution/index.js"
  },
  "keywords": [
    "tag",
    "hierarchical",
    "typescript",
    "type-safe",
    "ts",
    "cli"
  ],
  "homepage": "https://tag.sorrell.sh",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/TagCli",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "24.12.2",
    "create-ts-tag-cli": "^1.0.0",
    "package-json-type": "^1.1.2",
    "ts-tag": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-json-schema": "^0.67.1"
  },
  "dependencies": {
    "@sorrell/effect-cli": "*",
    "@sorrell/effect-platform": "*",
    "@effect/platform-node": "0.106.0",
    "@sorrell/cli-utilities": "1.0.94",
    "@sorrell/utilities": "1.2.31",
    "csv-parse": "^6.2.1",
    "effect": "3.21.2",
    "yaml": "^2.8.4"
  }
}
