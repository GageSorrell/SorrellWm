{
  "name": "code-auger-old",
  "version": "0.1.7",
  "description": "A CLI tool for managing code auto-generated by your dependencies.",
  "scripts": {
    "build": "tsc -p ./tsconfig.json"
  },
  "exports": {
    ".": {
      "import": "./Distribution/Consumer.js",
      "types": "./Distribution/Consumer.d.ts"
    },
    "./package-json-type": {
      "default": "./Distribution/Miscellaneous/PackageJson.Consumer.Types.d.ts",
      "import": "./Distribution/Miscellaneous/PackageJson.Consumer.Types.d.ts",
      "types": "./Distribution/Miscellaneous/PackageJson.Consumer.Types.d.ts"
    },
    "./provider/package-json-type": {
      "default": "./Distribution/Miscellaneous/PackageJson.Provider.Types.d.ts",
      "import": "./Distribution/Miscellaneous/PackageJson.Provider.Types.d.ts",
      "types": "./Distribution/Miscellaneous/PackageJson.Provider.Types.d.ts"
    },
    "./create": {
      "import": "./Distribution/Create.js",
      "types": "./Distribution/Create.d.ts"
    },
    "./provider": {
      "import": "./Distribution/Provider.js",
      "types": "./Distribution/Provider.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "Distribution",
    "package.json",
    "License.md",
    "ReadMe.md",
    "Resource"
  ],
  "keywords": [
    "code-gen",
    "code-generation",
    "cli",
    "augmentation",
    "auger",
    "module-augmentation",
    "typescript",
    "ts"
  ],
  "homepage": "https://code-auger.sorrell.sh",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/CodeAuger",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "license": "MIT",
  "bin": {
    "code-auger": "./Distribution/Bin/Bin.js"
  },
  "devDependencies": {
    "@types/node": "24.13.0",
    "package-json-type": "1.1.2",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "package-json-type": {
      "optional": true
    }
  },
  "peerDependencies": {
    "package-json-type": "1.1.2"
  }
}
