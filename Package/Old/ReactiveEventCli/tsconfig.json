{
    "compilerOptions":
    {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": "./Source",
        "outDir": "./Distribution",

        "lib":
        [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],

        "jsx": "react-jsx",

        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": [ "node" ],

        "strict": true,
        "isolatedModules": true,

        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "useUnknownInCatchVariables": true,

        "skipLibCheck": true,
        "noEmitOnError": true
    },
    "include": [ "Source/**/*" ],
    "exclude":
    [
        "Distribution",
        "Documentation",
        "node_modules"
    ]
}
