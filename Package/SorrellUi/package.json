{
  "name": "@sorrell/ui",
  "private": false,
  "description": "React components for marketing and landing-page UI, ported from the Effect website's design language.",
  "version": "1.0.0",
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/SorrellUi#ReadMe",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/SorrellUi",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./style.css": "./Distribution/Style.css",
    "./Button": {
      "import": "./Distribution/Button.js",
      "types": "./Distribution/Button.d.ts"
    },
    "./CallToAction": {
      "import": "./Distribution/CallToAction.js",
      "types": "./Distribution/CallToAction.d.ts"
    },
    "./CaseStudyList": {
      "import": "./Distribution/CaseStudyList.js",
      "types": "./Distribution/CaseStudyList.d.ts"
    },
    "./ClassName": {
      "import": "./Distribution/ClassName.js",
      "types": "./Distribution/ClassName.d.ts"
    },
    "./ComparisonChart": {
      "import": "./Distribution/ComparisonChart.js",
      "types": "./Distribution/ComparisonChart.d.ts"
    },
    "./Faq": {
      "import": "./Distribution/Faq.js",
      "types": "./Distribution/Faq.d.ts"
    },
    "./FeatureGrid": {
      "import": "./Distribution/FeatureGrid.js",
      "types": "./Distribution/FeatureGrid.d.ts"
    },
    "./GridBackground": {
      "import": "./Distribution/GridBackground.js",
      "types": "./Distribution/GridBackground.d.ts"
    },
    "./Hero": {
      "import": "./Distribution/Hero.js",
      "types": "./Distribution/Hero.d.ts"
    },
    "./InstallCommandPanel": {
      "import": "./Distribution/InstallCommandPanel.js",
      "types": "./Distribution/InstallCommandPanel.d.ts"
    },
    "./Link": {
      "import": "./Distribution/Link.js",
      "types": "./Distribution/Link.d.ts"
    },
    "./QuoteMarquee": {
      "import": "./Distribution/QuoteMarquee.js",
      "types": "./Distribution/QuoteMarquee.d.ts"
    },
    "./SectionDivider": {
      "import": "./Distribution/SectionDivider.js",
      "types": "./Distribution/SectionDivider.d.ts"
    },
    "./UseQuoteMarquee": {
      "import": "./Distribution/UseQuoteMarquee.js",
      "types": "./Distribution/UseQuoteMarquee.d.ts"
    },
    "./VideoCard": {
      "import": "./Distribution/VideoCard.js",
      "types": "./Distribution/VideoCard.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json && npm run build:css",
    "build:css": "tailwindcss -i ./Source/Style/Global.css -o ./Distribution/Style.css --minify",
    "lint": "eslint --config ./eslint.config.js \"Source/**/*.{ts,tsx}\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit -p ./tsconfig.json"
  },
  "keywords": [
    "landing-page",
    "marketing",
    "react",
    "tailwind",
    "ui"
  ],
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@sorrell/tsconfig": "1.0.0",
    "@tailwindcss/cli": "^4.3.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=26.6.0",
    "npm": ">=12.0.2"
  }
}
