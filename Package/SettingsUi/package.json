{
  "name": "@sorrell/settings-ui",
  "private": false,
  "description": "Fluent-based UI for creating user interfaces to manage application settings.",
  "version": "1.0.0",
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/SettingsUi#ReadMe",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/SettingsUi",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./OptionalSetting": {
      "import": "./Distribution/OptionalSetting.js",
      "types": "./Distribution/OptionalSetting.d.ts"
    },
    "./Setting": {
      "import": "./Distribution/Setting.js",
      "types": "./Distribution/Setting.d.ts"
    },
    "./SettingControlsContext": {
      "import": "./Distribution/SettingControlsContext.js",
      "types": "./Distribution/SettingControlsContext.d.ts"
    },
    "./SettingControlsProvider": {
      "import": "./Distribution/SettingControlsProvider.js",
      "types": "./Distribution/SettingControlsProvider.d.ts"
    },
    "./SettingGroup": {
      "import": "./Distribution/SettingGroup.js",
      "types": "./Distribution/SettingGroup.d.ts"
    },
    "./SettingOption": {
      "import": "./Distribution/SettingOption.js",
      "types": "./Distribution/SettingOption.d.ts"
    },
    "./SettingsHeader": {
      "import": "./Distribution/SettingsHeader.js",
      "types": "./Distribution/SettingsHeader.d.ts"
    },
    "./SettingToggle": {
      "import": "./Distribution/SettingToggle.js",
      "types": "./Distribution/SettingToggle.d.ts"
    },
    "./SuccessMessageBar": {
      "import": "./Distribution/SuccessMessageBar.js",
      "types": "./Distribution/SuccessMessageBar.d.ts"
    },
    "./UseSettingControls": {
      "import": "./Distribution/UseSettingControls.js",
      "types": "./Distribution/UseSettingControls.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --config ./.eslintrc.cjs --resolve-plugins-relative-to ../EsLintConfigSorrell --ext .ts,.tsx Source",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit -p ./tsconfig.json"
  },
  "keywords": [
    "fluent-ui",
    "react",
    "settings",
    "ui"
  ],
  "type": "module",
  "peerDependencies": {
    "@fluentui/react-components": "^9.0.0",
    "@fluentui/react-icons": "^2.0.0",
    "@fluentui/react-motion": "^9.0.0",
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.4",
    "@fluentui/react-icons": "2.0.333",
    "@fluentui/react-motion": "9.16.1",
    "@sorrell/tsconfig": "1.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=26.5.0",
    "npm": ">=12.0.1"
  }
}
