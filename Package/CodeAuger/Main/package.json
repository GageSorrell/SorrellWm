{
  "name": "code-auger",
  "version": "0.1.8",
  "description": "A CLI tool for managing code auto-generated by your dependencies.",
  "scripts": {
    "prebuild": "cli-utilities write-version ./Source/Bin/Version.ts",
    "precli": "npm run build",
    "cli": "node ./Distribution/Bin/Bin.js ls",
    "build": "tsc -b ./tsconfig.json"
  },
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./config": {
      "default": "./Distribution/Config/index.js",
      "import": "./Distribution/Config/index.js",
      "types": "./Distribution/Config/index.d.ts"
    },
    "./provider": {
      "default": "./Distribution/Provider/index.js",
      "import": "./Distribution/Provider/index.js",
      "types": "./Distribution/Provider/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "Distribution",
    "package.json",
    "License.md",
    "ReadMe.md",
    "Resource"
  ],
  "keywords": [
    "code-gen",
    "code-generation",
    "cli",
    "augmentation",
    "auger",
    "module-augmentation",
    "typescript",
    "ts"
  ],
  "homepage": "https://code-auger.sorrell.sh",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/CodeAuger/Main",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "license": "MIT",
  "bin": {
    "code-auger": "./Distribution/Bin/Bin.js"
  },
  "devDependencies": {
    "@types/node": "24.12.2"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "@effect/platform": "0.96.1",
    "@effect/platform-node": "0.106.0",
    "@sorrell/cli-utilities": "1.0.94",
    "@sorrell/effect-cli": "1.0.9",
    "@sorrell/utilities": "1.2.31",
    "cli-table3": "0.6.5",
    "effect": "3.21.2",
    "typescript": "6.0.3"
  }
}
