{
  "name": "code-auger",
  "version": "0.1.0",
  "description": "A CLI tool for managing code auto-generated by your dependencies.",
  "scripts": {
    "build": "tsc -p ./tsconfig.json"
  },
  "exports": {
    ".": {
      "default": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./author-config-schema": "./Author.Config.Schema.json",
    "./config-schema": "./Config.Schema.json"
  },
  "files": [
    "Distribution",
    "package.json",
    "License.md",
    "ReadMe.md"
  ],
  "keywords": [
    "code-gen",
    "code-generation",
    "cli",
    "augmentation",
    "auger",
    "module-augmentation",
    "typescript",
    "ts"
  ],
  "homepage": "https://code-auger.sorrell.sh",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/CodeAuger",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "license": "MIT",
  "bin": {
    "code-auger": "./Distribution/Bin/Bin.js"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "package-json-type": "1.1.2",
    "typescript": "6.0.3"
  }
}
