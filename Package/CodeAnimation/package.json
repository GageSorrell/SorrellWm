{
  "name": "@sorrell/code-animation",
  "private": false,
  "version": "1.0.28",
  "description": "A helper library for making animations with Code Hike.",
  "scripts": {
    "copy-markdown": "shx mkdir -p ./Intermediate/Development/ && copyfiles -u 1 \"Source/**/*.md\" Intermediate",
    "dev:build": "tsc -w -p ./tsconfig.remotion.json",
    "dev:watch": "chokidar \"Source/**/*.md\" -c \"npm run copy-markdown\"",
    "dev": "concurrently -n tsc,remotion,chokidar \"npm run dev:build\" \"npm run dev:studio\" \"npm run dev:watch\"",
    "predev:studio": "npm run copy-markdown",
    "dev:studio": "remotion studio --log=verbose --no-open --config=./remotion.config.ts",
    "build": "concurrently -n main,config \"npm run build:main\" \"npm run build:config\"",
    "build:main": "tsc -p ./tsconfig.json",
    "build:config": "esbuild ./remotion.config.exported.cts --bundle --platform=node --format=cjs --target=node20 --packages=external --outfile=remotion.config.exported.cjs",
    "postbuild": "ts-node --project ./tsconfig.script.json ./Script/AppendMarkdownModule.ts"
  },
  "keywords": [
    "codehike",
    "sorrell",
    "react",
    "remotion",
    "animation",
    "code",
    "presentation",
    "next"
  ],
  "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/CodeAnimation#ReadMe",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/CodeAnimation",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "license": "MIT",
  "peerDependencies": {
    "@remotion/cli": "4.0.462",
    "remotion": "4.0.462"
  },
  "peerDependenciesMeta": {
    "remotion": {
      "optional": true
    },
    "@remotion/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@remotion/cli": "4.0.462",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "chokidar-cli": "3.0.0",
    "concurrently": "8.2.2",
    "copyfiles": "^2.4.1",
    "esbuild": "0.28.0",
    "remotion": "4.0.462",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "Distribution",
    "Distribution/**/*",
    "ReadMe.md",
    "License.md",
    "remotion.config.exported.cjs",
    "Remotion.d.ts",
    "tsconfig.remotion.json"
  ],
  "types": "./Distribution/index.d.ts",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./tsconfig": "./tsconfig.remotion.json",
    "./remotion": "./remotion.config.exported.cjs"
  },
  "dependencies": {
    "@mdx-js/loader": "",
    "@mdx-js/react": "",
    "@remotion/zod-types": "4.0.462",
    "@sorrell/codehike": "^1.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "twoslash-cdn": "^0.2.9",
    "zod": "4.3.6"
  }
}
