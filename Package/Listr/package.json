{
    "name": "@sorrell/listr",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "build": "tsc -p ./tsconfig.json",
        "build:all": "npm run build && npm run build:test && npm run build:script",
        "build:script": "tsc -p ./tsconfig.Script.json",
        "build:test": "tsc -p ./tsconfig.Test.json",
        "test:bun:effect": "node --test ./Binaries/**/*.Test.js",
        "test:bun:main": "node --test ./Binaries/**/*.Test.js",
        "test:node:effect": "node --test ./Binaries/**/*.Test.js",
        "test:node:main": "node --test ./Binaries/**/*.Test.js",
        "pretest:bun:effect": "npm run build:test",
        "pretest:bun:main": "npm run build:test",
        "pretest:node:effect": "bun run build:test",
        "pretest:node:main": "bun run build:test",
        "test:bun": "bun test ./Binaries/**/*.Test.js",
        "test:all": "npm run test:node && npm run test:bun",
        "test": "npm run test"
    },
    "keywords": [
        "listr",
        "terminal",
        "interactive",
        "prompt",
        "effect",
        "functional",
        "typescript",
        "ts"
    ],
    "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/Utilities",
    "bugs": {
        "url": "https://github.com/GageSorrell/SorrellWm/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GageSorrell/SorrellWm.git"
    },
    "license": "MIT",
    "author": {
        "email": "gage@sorrell.sh",
        "name": "Gage Sorrell",
        "url": "https://sorrell.sh"
    },
    "type": "module",
    "experimental": {
        "@effect/experimental": {
            "optional": true
        },
        "@effect/platform": {
            "optional": true
        },
        "@effect/platform-bun": {
            "optional": true
        },
        "@effect/platform-node": {
            "optional": true
        }
    },
    "exports": {
        ".": {
            "types": "./Distribution/Index.Main.d.ts",
            "import": "./Distribution/Index.Main.js",
            "require": "./Distribution/Index.Main.js",
            "default": "./Distribution/Index.Main.js"
        },
        "./effect": {
            "types": "./Distribution/Effect/index.d.ts",
            "import": "./Distribution/Effect/index.js",
            "require": "./Distribution/Effect/index.js",
            "default": "./Distribution/Effect/index.js"
        },
        "./number": {
            "types": "./Distribution/Number/index.d.ts",
            "import": "./Distribution/Number/index.js",
            "require": "./Distribution/Number/index.js",
            "default": "./Distribution/Number/index.js"
        }
    },
    "peerDependencies": {
        "@effect/experimental": "^0.60.0",
        "@effect/platform-bun": "^0.89.0",
        "@effect/platform-node": "^0.106.0",
        "effect": "^3.21.1"
    },
    "devDependencies": {
        "@effect/experimental": "^0.60.0",
        "@effect/language-service": "^0.85.1",
        "@effect/platform": "^0.96.0",
        "@effect/platform-bun": "^0.89.0",
        "@effect/platform-node": "^0.106.0",
        "@sorrell/cli": "^0.0.1",
        "@types/node": "^25.6.0",
        "effect": "^3.21.1",
        "typescript": "npm:tsover@^6.0.0"
    },
    "dependencies": {
        "@sorrell/cli-utilities": "^1.0.36",
        "@sorrell/utilities": "^1.1.38"
    }
}
