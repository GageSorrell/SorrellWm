{
    "name": "electron-reactive-event",
    "version": "1.0.0",
    "description": "Type-safe Electron IPC functions, including modern React hooks.",
    "license": "MIT",
    "author": "Gage Sorrell <gage@sorrell.sh>",
    "type": "commonjs",
    "main": "./Distribution/index.js",
    "types": "./Distribution/index.d.ts",
    "exports": {
        ".": "./Distribution/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "clean": "rimraf ./Distribution",
        "prepublishOnly": "npm run build",
        "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Source --ext .ts,.tsx --format html -o ./EslintReport.html & npm run lint:view",
        "lint:view": "open-cli ./EslintReport.html"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/react": "^19.2.14",
        "@typescript-eslint/eslint-plugin": "^8.57.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.4",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-tsdoc": "^0.5.2",
        "open-cli": "^9.0.0",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1"
    },
    "dependencies": {
        "electron": "^41.0.3",
        "react": "^19.2.4"
    }
}
