  "types": "./Distribution/index.d.ts",
  "files": [
    "./package.json",
    "./Distribution/**/*"
  ],
  "overrides": {
    "typescript": "npm:tsover@^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.5",
    "clipboardy": "^5.3.1"
  },
  "peerDependencies": {
    "@types/react": "^19.2.14",
    "electron": "^41.4.0",
    "react": "^19.2.5"
  },
  "dependencies": {
    "@sorrell/utilities": "^1.2.4",
    "ora": "^9.3.0",
    "typescript": "npm:tsover@^6.0.0"
  }
}
