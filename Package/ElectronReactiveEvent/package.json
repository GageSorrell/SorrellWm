{
  "name": "electron-reactive-event",
  "version": "0.0.56",
  "description": "Type-safe Electron IPC functions, including modern React hooks.",
  "keywords": [
    "electron",
    "react",
    "event",
    "typescript",
    "type-safe",
    "reactive"
  ],
  "homepage": "https://electron-reactive-event.sorrell.sh",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/ElectronReactiveEvent",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "license": "MIT",
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "type": "commonjs",
  "exports": {
    ".": "./Distribution/index.js",
    "./registrar": {
      "types": "./Distribution/Registrar/Registrar.Types.d.ts",
      "default": "./Distribution/Registrar/Registrar.Types.js"
    },
    "./unsafe": "./Distribution/Unsafe/index.js"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "postinstall": "echo \"Consider installing `electron-reactive-event-cli` for automatic project setup.\""
