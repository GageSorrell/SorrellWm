{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2023",
        "module": "preserve",
        "types": [ "node" ],
        "moduleResolution": "bundler",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "noEmit": false
    },
    "include": [
        "Source/**/*.ts",
        "Source/**/*.tsx"
    ]
}
