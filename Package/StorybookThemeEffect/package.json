{
    "name": "@sorrell/storybook-theme-effect", "version": "1.0.0", "type": "module", "license": "MIT",
    "description": "Reusable Effect-inspired preset for Storybook.",
    "exports": {
        ".": { "types": "./Distribution/index.d.ts", "import": "./Distribution/index.js", "default": "./Distribution/index.js" },
        "./preset": { "types": "./Distribution/preset.d.ts", "import": "./Distribution/preset.js", "default": "./Distribution/preset.js" },
        "./package.json": "./package.json"
    },
    "files": [ "Distribution", "Source/Style.css", "License.md", "ReadMe.md" ],
    "scripts": { "build": "tsc -p tsconfig.json", "lint": "eslint --config eslint.config.js \"Source/**/*.{ts,tsx}\"", "typecheck": "tsc --noEmit -p tsconfig.json" },
    "peerDependencies": { "react": ">=19.2.0 <20", "react-dom": ">=19.2.0 <20", "storybook": "^10.5.5" },
    "devDependencies": { "@sorrell/tsconfig": "1.0.0", "@types/node": "26.1.1", "@types/react": "19.2.17", "react": "19.2.7", "react-dom": "19.2.7", "storybook": "10.5.5", "typescript": "6.0.2" }
}
