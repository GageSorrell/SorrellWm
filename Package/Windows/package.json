{
  "name": "@sorrell/windows",
  "private": false,
  "version": "1.0.0",
  "description": "Utilities for accessing the Windows API in NodeJS.",
  "keywords": [
    "windows",
    "win32",
    "api",
    "cpp",
    "c++",
    "cmake",
    "native",
    "typescript",
    "ts",
    "native-module",
    "utilities",
    "utils"
  ],
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/Windows#ReadMe",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/Windows",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./Distribution/index.js",
  "types": "./Distribution/index.d.ts",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/Release/SorrellWindows.node",
    "Distribution",
    "License.md",
    "ReadMe.md",
    "binding.gyp"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:native",
    "build:native": "node-gyp rebuild --enable-thin-lto=false --enable-lto=false --lto-jobs=",
    "build:js": "tsc -p ./tsconfig.json",
    "install": "npm run build:native",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --config ../../Configuration/.eslintrc.cjs --resolve-plugins-relative-to ../../Package/EsLintConfigSorrell --ext .ts Source",
    "prepare": "npm run build:js",
    "typecheck": "tsc --noEmit -p ./tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "cross-env": "10.1.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=26.5.0",
    "npm": ">=12.0.1"
  },
  "gypfile": true,
  "os": [
    "win32"
  ],
  "dependencies": {
    "@sorrell/math": "1.0.0",
    "effect": "^4.0.0-beta"
  }
}
