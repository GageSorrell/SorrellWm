/** A function that sets the message that is displayed to the user at a given point in time. */
export type TaskMessageFunction =
    {
        /**
         * A function that sets the message that is displayed to the user at a given point in time.
         *
         * @param NewMessage - The message to display to the user.
         */
        (NewMessage: string): void;
    };

/**
 * @property OnFail - Sets the message displayed when the task fails.
 * This does *not* cause the task to fail.
 *
 * @property OnSucceed - Sets the message displayed when the task succeeds.
 * This does *not* cause the task to succeed.
 *
 * @property Update - Sets the message displayed while the task is running.
 */
export type FMessageCallbacks =
    {
        OnFail: TaskMessageFunction;
        OnSucceed: TaskMessageFunction;
        Update: TaskMessageFunction;
    };

/**
 * An `async` function passed to {@link DoTask}, which optionally accepts
 * {@link FMessageCallbacks} to update the text displayed to the user.
 *
 * @typeParam Type - The type of the value returned by this task.
 */
export type TTaskFunction<Type> =
    | {
        /**
         * An `async` function passed to {@link DoTask}.
         *
         * @typeParam Type - The type of the value returned by this task.
         */
        (): Promise<Type>;
    }
    | {
        /**
         * An `async` function passed to {@link DoTask}, which accepts
         * {@link FMessageCallbacks} to update the text displayed to the user.
         *
         * @typeParam Type - The type of the value returned by this task.
         *
         * @param MessageCallbacks - An object containing callbacks to update
         * the message displayed to the user while this `async` function runs,
         * and when the function ends.
         */
        (MessageCallbacks: FMessageCallbacks): Promise<Type>;
    };

/**
 * An `async` function or `Promise` passed to {@link DoTask}.
 *
 * @typeParam Type - The type of the value returned by this task.
 */
export type TTask<Type> =
    | Promise<Type>
    | TTaskFunction<Type>;
