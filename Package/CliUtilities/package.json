  "type": "module",
  "exports": {
    ".": {
      "default": "./Distribution/index.js",
      "import": "./Distribution/index.js",
      "require": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./format": {
      "default": "./Distribution/Format/index.js",
      "import": "./Distribution/Format/index.js",
      "require": "./Distribution/Format/index.js",
      "types": "./Distribution/Format/index.d.ts"
    },
    "./fs": {
      "default": "./Distribution/FileSystem/index.js",
      "import": "./Distribution/FileSystem/index.js",
      "require": "./Distribution/FileSystem/index.js",
      "types": "./Distribution/FileSystem/index.d.ts"
    },
    "./inquirer": {
      "default": "./Distribution/Inquirer/index.js",
      "import": "./Distribution/Inquirer/index.js",
      "require": "./Distribution/Inquirer/index.js",
      "types": "./Distribution/Inquirer/index.d.ts"
    },
    "./command": {
      "default": "./Distribution/Command/index.js",
      "import": "./Distribution/Command/index.js",
      "require": "./Distribution/Command/index.js",
      "types": "./Distribution/Command/index.d.ts"
    },
    "./listr": {
      "default": "./Distribution/Listr/index.js",
      "import": "./Distribution/Listr/index.js",
      "require": "./Distribution/Listr/index.js",
      "types": "./Distribution/Listr/index.d.ts"
    },
    "./pty": {
      "default": "./Distribution/PseudoTerminal/index.js",
      "import": "./Distribution/PseudoTerminal/index.js",
      "require": "./Distribution/PseudoTerminal/index.js",
      "types": "./Distribution/PseudoTerminal/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "package-json-type": "^1.1.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@effect/platform": "^0.96.0",
    "@listr2/prompt-adapter-enquirer": "^4.2.1",
    "@sorrell/utilities": "^1.2.4",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.3.1",
    "commander": "^14.0.3",
    "effect": "^3.21.1",
    "en-inflectors": "^1.0.12",
    "listr2": "^10.2.1",
    "node-pty": "^1.1.0",
    "ora": "^9.3.0"
  }
