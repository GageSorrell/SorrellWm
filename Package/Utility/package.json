{
  "name": "@sorrell/utility",
  "private": false,
  "version": "1.4.2",
  "description": "General-purpose utilities for TypeScript and effect.",
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./Async": {
      "import": "./Distribution/Async.js",
      "types": "./Distribution/Async.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./tsconfig.test.json"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@sorrell/tsconfig": "1.0.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@sorrell/effect": "1.0.0",
    "effect": "4.0.0-rc.109"
  }
}
