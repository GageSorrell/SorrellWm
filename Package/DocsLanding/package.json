{
    "name": "@sorrell/docs-landing",
    "version": "1.0.0",
    "description": "Shared landing-page template for Sorrell documentation websites.",
    "type": "module",
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./Distribution/index.d.ts",
            "import": "./Distribution/index.js",
            "default": "./Distribution/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [ "Distribution", "License.md", "ReadMe.md" ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "lint": "eslint --config eslint.config.js \"Source/**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@sorrell/ui": "1.0.0"
    },
    "peerDependencies": {
        "react": ">=19.2.0 <20",
        "react-dom": ">=19.2.0 <20"
    },
    "devDependencies": {
        "@sorrell/tsconfig": "1.0.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "typescript": "6.0.2"
    },
    "engines": { "node": ">=26.6.0", "npm": ">=12.0.2" }
}
