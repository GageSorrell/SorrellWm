{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "incremental": false,
    "noUnusedLocals": true,
        "paths": {
            "@constants": [ "./constants" ],
            "@interfaces": [ "./interfaces" ],
            "@lib": [ "./lib" ],
            "@presets": [ "./presets" ],
            "@renderer": [ "./renderer" ],
            "@utils": [ "./utils" ],
            "@root": [ "./" ]
        }
  },
  "exclude": [ "node_modules", "dist", "tests", "**/*spec.ts" ],
  "include": [ "Source/**/*" ]
}
