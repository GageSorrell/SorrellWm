{
  "name": "@sorrell/listr",
  "version": "1.0.1",
  "description": "Terminal task list reborn! Create beautiful CLI interfaces via easy and logical to implement task lists that feel alive and interactive.",
  "license": "MIT",
  "repository": "https://github.com/listr2/listr2",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "authors": [
    {
      "name": "Gage Sorrell",
      "email": "gage@sorrell.sh",
      "url": "https://sorrell.sh"
    },
    {
      "name": "Cenk Kilic",
      "email": "cenk@kilic.dev",
      "url": "https://cenk.kilic.dev"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "check": "tsc -p ./tsconfig.json --noEmit",
    "build": "tsdown ./Source/index.ts",
    "dev:start": "tsdown --watch --tsconfig",
    "test": "NODE_OPTIONS=\"--no-warnings --experimental-vm-modules\" jest --config tests/jest.config.ts",
    "test:cov": "npm run test --coverage",
    "script": "ts-node -P ./tsconfig.script.json Script.ts",
    "test:dev": "NODE_OPTIONS='--no-warnings --experimental-vm-modules --inspect=0.0.0.0:9229' npm run test --verbose --watchAll"
  },
  "keywords": [
    "listr",
    "listr2",
    "cli",
    "task",
    "list",
    "tasklist",
    "terminal",
    "term",
    "console",
    "ascii",
    "unicode",
    "loading",
    "indicator",
    "progress",
    "busy",
    "wait",
    "idle"
  ],
  "dependencies": {
    "@sorrell/utilities": "1.2.15",
    "cli-truncate": "^5.2.0",
    "en-inflectors": "^1.0.12",
    "eventemitter3": "^5.0.4",
    "log-update": "^6.1.0",
    "rfdc": "^1.4.1",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@swc/core": "^1.15.30",
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/zen-observable": "^0.8.7",
    "chalk": "^5.6.2",
    "jest": "^30.3.0",
    "package-json-type": "^1.1.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.21.9",
    "zen-observable": "^0.10.0"
  }
}
