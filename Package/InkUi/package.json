{
    "name": "@sorrell/ink-ui",
    "version": "1.0.0",
    "description": "Reusable, themed terminal UI components for Ink.",
    "author": {
        "email": "gage@sorrell.sh",
        "name": "Gage Sorrell",
        "url": "https://sorrell.sh"
    },
    "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/InkUi#readme",
    "bugs": {
        "url": "https://github.com/GageSorrell/SorrellWm/issues"
    },
    "repository": {
        "directory": "Package/InkUi",
        "type": "git",
        "url": "git+https://github.com/GageSorrell/SorrellWm.git"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "import": "./Distribution/index.js",
            "types": "./Distribution/index.d.ts"
        },
        "./Backdrop": {
            "import": "./Distribution/Backdrop/index.js",
            "types": "./Distribution/Backdrop/index.d.ts"
        },
        "./Mouse": {
            "import": "./Distribution/Mouse/index.js",
            "types": "./Distribution/Mouse/index.d.ts"
        },
        "./Box": {
            "import": "./Distribution/Box/index.js",
            "types": "./Distribution/Box/index.d.ts"
        },
        "./Button": {
            "import": "./Distribution/Button/index.js",
            "types": "./Distribution/Button/index.d.ts"
        },
        "./Display": {
            "import": "./Distribution/Display/index.js",
            "types": "./Distribution/Display/index.d.ts"
        },
        "./Help": {
            "import": "./Distribution/Help/index.js",
            "types": "./Distribution/Help/index.d.ts"
        },
        "./Text": {
            "import": "./Distribution/Text.js",
            "types": "./Distribution/Text.d.ts"
        },
        "./Icon": {
            "import": "./Distribution/Icon/index.js",
            "types": "./Distribution/Icon/index.d.ts"
        },
        "./LaTeX": {
            "import": "./Distribution/LaTeX/index.js",
            "types": "./Distribution/LaTeX/index.d.ts"
        },
        "./PhosphorIcon": {
            "import": "./Distribution/PhosphorIcon/index.js",
            "types": "./Distribution/PhosphorIcon/index.d.ts"
        },
        "./PhosphorIcon/*": {
            "import": "./Distribution/PhosphorIcon/*.js",
            "types": "./Distribution/PhosphorIcon/*.d.ts"
        },
        "./Shadow": {
            "import": "./Distribution/Shadow/index.js",
            "types": "./Distribution/Shadow/index.d.ts"
        },
        "./ScrollView": {
            "import": "./Distribution/ScrollView.js",
            "types": "./Distribution/ScrollView.d.ts"
        },
        "./Svg": {
            "import": "./Distribution/Svg/index.js",
            "types": "./Distribution/Svg/index.d.ts"
        },
        "./Support": {
            "import": "./Distribution/Support/index.js",
            "types": "./Distribution/Support/index.d.ts"
        },
        "./Three": {
            "import": "./Distribution/Three/index.js",
            "types": "./Distribution/Three/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "Distribution",
        "License.md",
        "ReadMe.md",
        "ThirdPartyNotices.md"
    ],
    "scripts": {
        "build": "tsc -p ./tsconfig.json",
        "build:showcase": "tsc -p ./tsconfig.showcase.json",
        "lint": "eslint --config ./eslint.config.js \"Source/**/*.{ts,tsx}\" \"Showcase/**/*.{ts,tsx}\" \"Test/**/*.{ts,tsx}\"",
        "showcase": "npm run build:showcase && node ./Intermediate/Showcase/Showcase/index.js",
        "generate:bit-fonts": "node ./Script/GenerateBitFonts.mjs",
        "generate:phosphor-icons": "node ./Script/GeneratePhosphorIcons.mjs",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p ./tsconfig.json && tsc --noEmit -p ./tsconfig.test.json && tsc --noEmit -p ./tsconfig.showcase.json"
    },
    "peerDependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "ink": "^7.1.0",
        "react": ">=19.2.0 <20",
        "react-dom": ">=19.2.0 <20",
        "three": "^0.185.1"
    },
    "peerDependenciesMeta": {
        "@phosphor-icons/react": {
            "optional": true
        },
        "ink": {
            "optional": false
        },
        "react": {
            "optional": false
        },
        "react-dom": {
            "optional": false
        },
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@phosphor-icons/react": "2.1.10",
        "@sorrell/tsconfig": "1.0.0",
        "@types/node": "26.1.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@types/three": "^0.185.0",
        "cross-env": "10.1.0",
        "ink": "7.1.0",
        "ink-testing-library": "4.0.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "three": "^0.185.1",
        "typescript": "6.0.2",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "@resvg/resvg-js": "2.6.2",
        "@sorrell/math": "1.0.0",
        "color-name": "1.1.4",
        "effect": "4.0.0-beta.102",
        "jsonc-parser": "3.3.1",
        "mathjax": "4.1.3",
        "sixel": "0.16.0"
    },
    "engines": {
        "node": ">=26.6.0",
        "npm": ">=12.0.2"
    }
}
