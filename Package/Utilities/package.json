{
    "name": "@sorrell/utilities",
    "version": "1.1.51",
    "private": false,
    "description": "Various TypeScript utilities.",
    "keywords": [
        "utility",
        "utilities",
        "typescript",
        "ts"
    ],
    "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/Utilities",
    "bugs": {
        "url": "https://github.com/GageSorrell/SorrellWm/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GageSorrell/SorrellWm.git"
    },
    "license": "MIT",
    "author": {
        "email": "gage@sorrell.sh",
        "name": "Gage Sorrell",
        "url": "https://sorrell.sh"
    },
    "type": "module",
    "files": [
        "./Distribution/**/*",
        "./ReadMe.md",
        "./package.json"
    ],
    "exports": {
        ".": {
            "types": "./Distribution/index.d.ts",
            "import": "./Distribution/index.js",
            "require": "./Distribution/index.js",
            "default": "./Distribution/index.js"
        },
        "./array": {
            "types": "./Distribution/Array/index.d.ts",
            "import": "./Distribution/Array/index.js",
            "require": "./Distribution/Array/index.js",
            "default": "./Distribution/Array/index.js"
        },
        "./async": {
            "types": "./Distribution/Async/index.d.ts",
            "import": "./Distribution/Async/index.js",
            "require": "./Distribution/Async/index.js",
            "default": "./Distribution/Async/index.js"
        },
        "./effect": {
            "types": "./Distribution/Effect/index.d.ts",
            "import": "./Distribution/Effect/index.js",
            "require": "./Distribution/Effect/index.js",
            "default": "./Distribution/Effect/index.js"
        },
        "./fs": {
            "types": "./Distribution/FileSystem/index.d.ts",
            "import": "./Distribution/FileSystem/index.js",
            "require": "./Distribution/FileSystem/index.js",
            "default": "./Distribution/FileSystem/index.js"
        },
        "./functional": {
            "types": "./Distribution/Functional/index.d.ts",
            "import": "./Distribution/Functional/index.js",
            "require": "./Distribution/Functional/index.js",
            "default": "./Distribution/Functional/index.js"
        },
        "./misc": {
            "types": "./Distribution/Miscellaneous/index.d.ts",
            "import": "./Distribution/Miscellaneous/index.js",
            "require": "./Distribution/Miscellaneous/index.js",
            "default": "./Distribution/Miscellaneous/index.js"
        },
        "./npm": {
            "types": "./Distribution/Npm/index.d.ts",
            "import": "./Distribution/Npm/index.js",
            "require": "./Distribution/Npm/index.js",
            "default": "./Distribution/Npm/index.js"
        },
        "./number": {
            "types": "./Distribution/Number/index.d.ts",
            "import": "./Distribution/Number/index.js",
            "require": "./Distribution/Number/index.js",
            "default": "./Distribution/Number/index.js"
        },
        "./number-experimental": {
            "types": "./Distribution/Number/Index.Experimental.d.ts",
            "import": "./Distribution/Number/Index.Experimental.js",
            "require": "./Distribution/Number/Index.Experimental.js",
            "default": "./Distribution/Number/Index.Experimental.js"
        }
    },
    "overrides": {
        "typescript": "npm:tsover@^6.0.0"
    },
    "peerDependenciesMeta": {
        "tsover": {
            "optional": true
        },
        "tsover-runtime": {
            "optional": true
        }
    },
    "main": "./Distribution/index.js",
    "types": "./Distribution/types/index.d.ts",
    "scripts": {
        "prepublish": "npm run build",
         "build:js": "node esbuild.config.mts",
        "build:types": "tsc -p tsconfig.types.json",
        "build": "npm run build:js && npm run build:types"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/node": "^25.6.0",
        "clipboardy": "^5.3.1",
        "esbuild": "^0.28.0",
        "package-json-type": "^1.1.2",
        "rollup": "^4.60.2",
        "tslib": "^2.8.1",
        "tsover": "^6.0.0",
        "tsover-runtime": "0.0.6",
        "typescript": "npm:tsover@^6.0.0"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "effect": "^3.21.1"
    },
    "peerDependencies": {
        "tsover": "^6.0.0",
        "tsover-runtime": "^0.0.6"
    }
}
