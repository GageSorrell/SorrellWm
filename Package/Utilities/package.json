{
    "name": "@sorrell/utilities",
    "version": "1.1.14",
    "private": false,
    "description": "Various TypeScript utilities.",
    "keywords": [
        "utility",
        "utilities",
        "typescript",
        "ts"
    ],
    "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/Utilities",
    "bugs": {
        "url": "https://github.com/GageSorrell/SorrellWm/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GageSorrell/SorrellWm.git"
    },
    "license": "MIT",
    "bin": {
        "publish-bump-safe": "./Distribution/Binaries/PublishBumpSafe.js"
    },
    "author": "Gage Sorrell <gage@sorrell.sh>",
    "type": "module",
    "files": [
        "./Distribution/**/*",
        "./Source/**/*",
        "./ReadMe.md",
        "./package.json",
        "tsconfig.json"
    ],
    "exports": {
        ".": {
            "types": "./Distribution/index.d.ts",
            "import": "./Distribution/index.js",
            "require": "./Distribution/index.js",
            "default": "./Distribution/index.js"
        }
    },
    "main": "Distribution/index.js",
    "types": "Distribution/index.d.ts",
    "scripts": {
        "build": "tsc -p ./tsconfig.json",
        "publish-bump-safe": "node ./Distribution/Binaries/PublishBumpSafe.js"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "package-json-type": "^1.1.2",
        "typescript": "^6.0.2"
    }
}
