{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "types": [ "node" ],
        "lib":
        [
            "tsover",
            "ES2021"
        ],
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "declarationDir": "./Distribution/Types",
        "noEmit": false
    },
    "include":
    [
        "Source/**/*.ts",
        "Source/**/*.tsx"
    ]
}
