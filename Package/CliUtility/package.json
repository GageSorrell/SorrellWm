{
    "name": "@sorrell/cli-utility",
    "version": "1.0.0-beta.1",
    "private": false,
    "description": "Utilities for CLI applications.",
    "keywords": [
        "cli",
        "utility",
        "sorrell",
        "typescript",
        "effect"
    ],
    "homepage": "https://github.com/GageSorrell/SorrellWm/tree/Master/Package/CliUtility#ReadMe",
    "license": "MIT",
    "bugs": {
