    },
    "repository": {
        "directory": "Package/CliUtility",
        "type": "git",
        "url": "git+https://github.com/GageSorrell/SorrellWm.git"
    },
    "author": {
        "email": "gage@sorrell.sh",
        "name": "Gage Sorrell",
        "url": "https://sorrell.sh"
    },
    "type": "module",
    "scripts": {
        "build": "tsc -p ./tsconfig.json",
        "lint": "eslint --config ./eslint.config.js \"Source/**/*.ts\""
