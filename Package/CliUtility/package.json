            "types": "./Distribution/Format.d.ts"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "effect": "^4.0.0-rc.109",
        "@effect/platform-node": "^4.0.0-rc.109",
        "@sorrell/utility": "1.1.0",
        "@sorrell/math": "1.0.0"
    },
    "devDependencies": {
        "typescript": "6.0.2",
        "@sorrell/tsconfig": "2.1.0",
        "@sorrell/eslint-config": "1.0.1",
        "cross-env": "10.1.0"
    }
