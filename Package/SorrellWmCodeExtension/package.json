{
    "name": "sorrell-wm-code-extension",
    "displayName": "SorrellWm Code Extension",
    "version": "0.1.0",
    "description": "Workspace automation for the SorrellWm TypeScript and C++ source conventions.",
    "publisher": "GageSorrell",
    "maintainers":
    [
        "Gage Sorrell <gage@sorrell.sh>"
    ],
    "license": "MIT",
    "author": {
        "name": "Gage Sorrell",
        "email": "gage@sorrell.sh"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/GageSorrell/SorrellWm.git"
    },
    "bugs": {
        "url": "https://github.com/GageSorrell/SorrellWm/issues"
    },
    "homepage": "https://github.com/GageSorrell/SorrellWm/tree/main/Package/SorrellWmCodeExtension",
    "icon": "Resource/Icon.png",
    "type": "module",
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "sorrellwm",
        "typescript",
        "cpp",
        "jsdoc"
    ],
    "activationEvents": [
        "*"
    ],
    "extensionKind": [
        "workspace"
    ],
    "main": "./Distribution/extension.cjs",
    "files": [
        "Distribution/extension.cjs",
        "Distribution/extension.cjs.map",
        "License.md",
        "ReadMe.md",
        "Resource/Icon.png",
        "package.json"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "The extension edits newly created TypeScript and C++ files."
        }
    },
    "contributes": {
        "configuration": {
            "title": "SorrellWm Code Extension",
            "properties": {
                "sorrellWmCodeExtension.headers.insertOnAnyFileCreation": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "When enabled, inserts the generated source header into every newly created TypeScript or C++ file, no matter how it was created. When disabled, the header is only inserted into files created through an editor gesture such as the Explorer's \"New File\" command, or into files that are empty or contain only whitespace when saved."
                }
            }
        },
        "commands": [
            {
                "category": "SorrellWm",
                "command": "sorrellWmCodeExtension.createReactComponent",
                "title": "Create React Component"
            }
        ],
        "languageModelTools": [
            {
                "canBeReferencedInPrompt": true,
                "displayName": "Create React Component",
                "icon": "$(symbol-class)",
                "inputSchema": {
                    "additionalProperties": false,
                    "properties": {
                        "componentName": {
                            "description": "The valid PascalCase TypeScript identifier to use for the React component and its directory.",
                            "minLength": 1,
                            "type": "string"
                        },
                        "directoryPath": {
                            "description": "The absolute path of an existing directory inside an open workspace folder. The new component directory will be created beneath this directory.",
                            "minLength": 1,
                            "type": "string"
                        }
                    },
                    "required": [
                        "componentName",
                        "directoryPath"
                    ],
                    "type": "object"
                },
                "modelDescription": "Creates a React component directory with the six standard SorrellWm component files and returns the absolute path of the created directory. Use this tool when the user asks to scaffold a new React component. The component name must be a valid PascalCase TypeScript identifier, and directoryPath must be an absolute path to an existing directory inside the open workspace. The tool fails rather than overwriting an existing file or directory.",
                "name": "sorrellWm_createReactComponent",
                "toolReferenceName": "createReactComponent",
                "userDescription": "Create a standard SorrellWm React component directory and its six source files.",
                "when": "workspaceFolderCount != 0"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "sorrellWmCodeExtension.createReactComponent",
                    "group": "2_workspace@1"
                }
            ]
        }
    },
    "scripts": {
        "build": "npm run typecheck && esbuild Source/Extension.ts --bundle --external:vscode --format=cjs --platform=node --target=node20 --outfile=Distribution/extension.cjs --sourcemap",
        "lint": "eslint --config ../../Configuration/eslint.config.js \"Source/**/*.ts\" \"Test/**/*.ts\"",
        "package:vsix": "vsce package --allow-star-activation --no-dependencies --out ./SorrellWmCodeExtension.vsix",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "vscode:prepublish": "npm run build"
    },
    "devDependencies": {
        "@sorrell/eslint-config": "file:../EsLintConfigSorrell",
        "@types/node": "24.13.3",
        "@types/vscode": "1.125.0",
        "@vscode/vsce": "3.9.2",
        "cross-env": "10.1.0",
        "esbuild": "0.28.1",
        "eslint": "9.39.5",
        "typescript": "6.0.2",
        "vitest": "4.1.10"
    }
}
