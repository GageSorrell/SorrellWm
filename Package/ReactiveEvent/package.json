{
  "name": "reactive-event",
  "version": "0.0.58",
  "description": "Type-safe Electron IPC functions, including modern React hooks.",
  "keywords": [
    "electron",
    "react",
    "event",
    "typescript",
    "type-safe",
    "reactive"
  ],
  "homepage": "https://reactive-event.sorrell.sh",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/ReactiveEvent",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "license": "MIT",
  "author": "Gage Sorrell <gage@sorrell.sh> (https://sorrell.sh)",
  "type": "commonjs",
  "exports": {
    ".": "./Distribution/index.js",
    "./registrar": {
      "types": "./Distribution/Registrar/Registrar.Types.d.ts",
      "default": "./Distribution/Registrar/Registrar.Types.js"
    },
    "./unsafe": "./Distribution/Unsafe/index.js"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "postinstall": "echo 'Consider installing [`reactive-event-cli`](https://www.npmjs.com/package/reactive-event-cli) for automatic project setup.'",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
  "types": "./Distribution/index.d.ts",
  "files": [
    "./package.json",
    "./Distribution/**/*",
    "!./Documentation",
    "!./Documentation/**/*",
    "!./DocumentationExperimental",
    "!./DocumentationExperimental/**/*",
    "!./Sample",
    "!./Sample/**/*"
  ],
  "overrides": {
    "typescript": "npm:tsover@^6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.0",
    "@types/react": "^19.2.5",
    "clipboardy": "^5.3.1",
    "vue": "^3.5.33"
  },
  "peerDependencies": {
    "@types/react": "^19.2.14",
    "electron": "^41.4.0",
    "react": "^19.2.5"
  },
  "dependencies": {
    "@sorrell/utilities": "1.2.31",
    "ora": "^9.3.0",
    "typescript": "npm:tsover@^6.0.0"
  },
  "main": "index.js"
}
