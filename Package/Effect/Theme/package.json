{
  "name": "@sorrell/effect-theme",
  "version": "1.0.9",
  "description": "Theme support for @sorrell/effect-cli/HelpDoc and @sorrell/effect-platform/Terminal.",
  "scripts": {
    "build": "tsc -p ./tsconfig.json"
  },
  "exports": {
    ".": {
      "import": "./Distribution/index.js",
      "types": "./Distribution/index.d.ts"
    },
    "./Args": {
      "default": "./Distribution/Args.js",
      "import": "./Distribution/Args.js",
      "types": "./Distribution/Args.d.ts"
    },
    "./AutoCorrect": {
      "default": "./Distribution/AutoCorrect.js",
      "import": "./Distribution/AutoCorrect.js",
      "types": "./Distribution/AutoCorrect.d.ts"
    },
    "./BuiltInOptions": {
      "default": "./Distribution/BuiltInOptions.js",
      "import": "./Distribution/BuiltInOptions.js",
      "types": "./Distribution/BuiltInOptions.d.ts"
    },
    "./CliApp": {
      "default": "./Distribution/CliApp.js",
      "import": "./Distribution/CliApp.js",
      "types": "./Distribution/CliApp.d.ts"
    },
    "./CliConfig": {
      "default": "./Distribution/CliConfig.js",
      "import": "./Distribution/CliConfig.js",
      "types": "./Distribution/CliConfig.d.ts"
    },
    "./Command": {
      "default": "./Distribution/Command.js",
      "import": "./Distribution/Command.js",
      "types": "./Distribution/Command.d.ts"
    },
    "./CommandDescriptor": {
      "default": "./Distribution/CommandDescriptor.js",
      "import": "./Distribution/CommandDescriptor.js",
      "types": "./Distribution/CommandDescriptor.d.ts"
    },
    "./CommandDirective": {
      "default": "./Distribution/CommandDirective.js",
      "import": "./Distribution/CommandDirective.js",
      "types": "./Distribution/CommandDirective.d.ts"
    },
    "./ConfigFile": {
      "default": "./Distribution/ConfigFile.js",
      "import": "./Distribution/ConfigFile.js",
      "types": "./Distribution/ConfigFile.d.ts"
    },
    "./HelpDoc": {
      "default": "./Distribution/HelpDoc.js",
      "import": "./Distribution/HelpDoc.js",
      "types": "./Distribution/HelpDoc.d.ts"
    },
    "./Options": {
      "default": "./Distribution/Options.js",
      "import": "./Distribution/Options.js",
      "types": "./Distribution/Options.d.ts"
    },
    "./Primitive": {
      "default": "./Distribution/Primitive.js",
      "import": "./Distribution/Primitive.js",
      "types": "./Distribution/Primitive.d.ts"
    },
    "./Prompt": {
      "default": "./Distribution/Prompt.js",
      "import": "./Distribution/Prompt.js",
      "types": "./Distribution/Prompt.d.ts"
    },
    "./Span": {
      "default": "./Distribution/Span.js",
      "import": "./Distribution/Span.js",
      "types": "./Distribution/Span.d.ts"
    },
    "./Usage": {
      "default": "./Distribution/Usage.js",
      "import": "./Distribution/Usage.js",
      "types": "./Distribution/Usage.d.ts"
    },
    "./ValidationError": {
      "default": "./Distribution/ValidationError.js",
      "import": "./Distribution/ValidationError.js",
      "types": "./Distribution/ValidationError.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "Distribution",
    "package.json",
    "License.md",
    "ReadMe.md",
    "Resource"
  ],
  "keywords": [
    "effect",
    "cli",
    "sorrell",
    "type-safety",
    "prompts",
    "prompting"
  ],
  "homepage": "https://effect-cli.sorrell.sh",
  "type": "module",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "directory": "Package/Effect/Cli",
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "author": {
    "email": "gage@sorrell.sh",
    "name": "Gage Sorrell",
    "url": "https://sorrell.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.12.2",
    "@effect/platform-node": "0.106.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@sorrell/cli-utilities": "1.0.94",
    "@sorrell/utilities": "1.2.31",
    "effect": "3.21.2"
  }
}
