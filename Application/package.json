{
  "name": "sorrellwm",
  "description": "The tiling window manager for everyone.",
  "keywords": [
    "electron",
    "macos",
    "windows-11",
    "window-manager",
    "wm",
    "fluent-ui"
  ],
  "homepage": "https://wm.sorrell.sh",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/GageSorrell/SorrellWm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GageSorrell/SorrellWm.git"
  },
  "license": "MIT",
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://github.com/GageSorrell"
  },
  "main": "./Intermediate/main.bundle.dev.js",
  "scripts": {
    "build-script": "tsc -p tsconfig.Script.json",
    "build-scripts": "npm run build-script",
    "build-win": "cd ./Windows && npm run build -- --disable-linting && cd ..",
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:dll": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./Configuration/Webpack/Renderer.Dev.Dll.ts",
    "build:main": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./Configuration/Webpack/Main.Prod.ts",
    "build:renderer": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./Configuration/Webpack/Renderer.Prod.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "kill-electron": "powershell -ExecutionPolicy Bypass -File ..\\Script\\KillElectronInstances\\KillElectronInstances.ps1",
    "generate-schema:devsettings": "npx typescript-json-schema ./tsconfig.JsonSchema.json FDevSettings --out ./Configuration/Development/DevSettings.Schema.json",
    "generate-schema:dummyconfiguration": "npx typescript-json-schema ./tsconfig.JsonSchema.json FDummyConfigurationSchema --out ./Configuration/Development/DummyConfiguration.Schema.json",
    "generate-schema:all": "npm run generate-schema:devsettings && npm run generate-schema:dummyconfiguration",
    "generate-schema": "npm run generate-schema:all",
    "generate-schemae": "npm run generate-schema:all",
    "generate-schemas": "npm run generate-schema:all",
    "postinstall": "npm run build-script && node ./Distribution/Script/CheckNativeDependencies.js && electron-builder install-app-deps",
    "lint": "npm run lint:all",
    "lint:all": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Configuration ./Resource ./Source ./Script --ext .js,.jsx,.ts,.tsx --format html -o ./EslintReport.html & npm run lint:view",
    "lint:custom": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" --ext .js,.jsx,.ts,.tsx",
    "lint:config": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Configuration --ext .js,.jsx,.ts,.tsx & npm run lint:view",
    "lint:main": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Source/Main --ext .js,.jsx,.ts,.tsx --format html -o ./EslintReport.html & npm run lint:view",
    "lint:renderer": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Source/Renderer --ext .js,.jsx,.ts,.tsx & npm run lint:view",
    "lint:resource": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Source/Resource --ext .js,.jsx,.ts,.tsx & npm run lint:view",
    "lint:source": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Source --ext .js,.jsx,.ts,.tsx & npm run lint:view",
    "lint:script": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Script --ext .js,.jsx,.ts,.tsx & npm run lint:view",
    "lint:shared": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" --rule \"@typescript-eslint/no-unused-expressions: off\" ./Source/Shared --ext .js,.jsx,.ts,.tsx & npm run lint:view",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=development eslint -c \"../Configuration/.eslintrc.cjs\" . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:view": "open-cli ./EslintReport.html",
    "package": "node ./Distribution/Script/Clean.js Distribution && npm run build && electron-builder build --publish never && npm run build:dll",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir Release/Application",
    "prestart-proper": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./Configuration/Webpack/Main.Dev.ts",
    "start-proper": "node ./Distribution/Script/CheckPortInUse.js && npm run prestart-proper && npm run start:renderer",
    "start": "npm run build-win && npm run start-electron",
    "start-electron": "node ./Distribution/Script/Start.js",
    "start:main": "concurrently --raw -k \"cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --watch --config ./Configuration/Webpack/Main.Dev.ts\" \"electronmon . --enable-logging\"",
    "start:preload": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./Configuration/Webpack/Preload.Dev.ts",
    "start:renderer": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./Configuration/Webpack/Renderer.Dev.ts",
    "prepare": "ts-patch install"
  },
  "browserslist": [
    "extends browserslist-config-erb"
  ],
  "dependencies": {
    "@electron/notarize": "^2.3.2",
    "@fluentui/react-components": "^9.73.2",
    "@fluentui/react-icons": "^2.0.321",
    "@fluentui/react-motion-components-preview": "^0.15.2",
    "@sorrellwm/event": "file:../Package/Event",
    "dot-prop": "^10.1.0",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-settings": "^4.0.4",
    "electron-updater": "^6.8.3",
    "openai": "^4.76.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "react-router-dom": "^6.16.0",
    "source-map-support": "^0.5.21",
    "typia": "^11.0.3",
    "util": "^0.12.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@sorrellwm/windows": "file:Windows",
    "@stylistic/eslint-plugin": "^2.11.0",
    "@svgr/webpack": "^8.1.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@types/detect-port": "^1.3.5",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^18.0.1",
    "@types/source-map-support": "^0.5.10",
    "@types/webpack-bundle-analyzer": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.1",
    "core-js": "^3.32.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^1.5.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^3.2.0",
    "electronmon": "^2.0.4",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-import-resolver-webpack": "^0.13.7",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "open-cli": "^8.0.0",
    "react-refresh": "^0.14.0",
    "rimraf": "^5.0.1",
    "sass": "^1.67.0",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "ts-patch": "^3.3.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "~5.9.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.88.2",
    "webpack-bundle-analyzer": "^4.9.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^5.9.0"
  },
  "build": {
    "productName": "SorrellWm",
    "appId": "org.sorrell.wm",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "Distribution",
      "node_modules",
      "package.json"
    ],
    "mac": {
      "sign": "Script/Notarize.js",
      "notarize": false,
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "Resource/entitlements.mac.plist",
      "entitlementsInherit": "Resource/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "requestedExecutionLevel": "highestAvailable",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "Release/Application",
      "buildResources": "Resource",
      "output": "Release/Build"
    },
    "extraResources": [
      "./Resource/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "GageSorrell",
      "repo": "SorrellWm"
    }
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "Source/Main/**",
      "Distribution/**"
    ],
    "logLevel": "info"
  },
  "overrides": {
    "form-data": "^4.0.5"
  }
}
