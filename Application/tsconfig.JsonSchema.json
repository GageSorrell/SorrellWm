{
    "compilerOptions":
    {
        "baseUrl": "./",
        "paths":
        {
            "#/*":
            [
                "./Source/Main/*"
            ],
            "@/*":
            [
                "./Source/Renderer/*"
            ],
            "$/*":
            [
                "./Source/Renderer/Domain/*"
            ],
            "!/*":
            [
                "./Source/Shared/*"
            ]
        },
        "incremental": true,
        "target": "es2022",
        "module": "commonjs",
        "lib": [ "dom", "es2022" ],
        "jsx": "react-jsx",
        "strict": false,
        "sourceMap": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "allowJs": true,
        "outDir": "Distribution"
    },
    "include":
    [
        "Configuration",
        "Source"
    ],
    "exclude":
    [
        "Windows",
        "Intermediate",
        "test",
        "node_modules",
        "Release/Build",
        "Release/Application/Distribution",
        "Distribution_2_5_26"
    ]
}
