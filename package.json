{
    "name": "@sorrellwm/monorepo",
    "description": "The tiling window manager for everyone.",
    "version": "0.0.0",
    "private": true,
    "keywords": [
        "electron",
        "wm",
        "fluent-ui",
        "windows-11",
        "windows",
        "window-manager",
        "tiling",
        "tiling-wm",
        "tiled"
    ],
    "homepage": "https://wm.sorrell.sh",
    "bugs": {
