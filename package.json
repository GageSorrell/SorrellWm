        "node": ">=24.15.0 <25",
        "npm": ">=11.0.0"
    },
    "type": "module",
    "scripts": {
        "clean": "npm run start -w @sorrellwm/clean-repo",
        "clean:install": "npm run start:install -w @sorrellwm/clean-repo",
        "clean:i": "npm run start:i -w @sorrellwm/clean-repo",
        "build:effect": "npm run build -w @sorrell/effect"
    },
    "overrides": {
        "effect@^4.0.0-beta.78": "file:E:\\SorrellWm\\Package\\Effect",
        "@tootallnate/once": "^3.0.1",
        "serialize-javascript": "^7.0.5",
        "tar": "^7.5.13",
        "uuid": "^14.0.0",
        "vite": "^8.0.10",
        "zod": "4.3.6",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "react": "19.2.3",
	    "react-dom": "19.2.3"
    },
    "workspaces": [
        "!Package/Create/CodeAuger",
        "Package/Effect",
        "!Package/EffectOld",
        "Package/CodeAuger/Main",
        "!Package/CodeAuger/Create",
        "Package/CodeAuger/Development",
        "Application",
        "!Application/Release/Application",
        "Package/*",
        "!Package/CodeHike",
        "Package/**/*",
        "!Package/Create/*",
        "Package/Ui/*",
        "!Package/Tag/Documentation",
        "!Package/Tag/Documentation/**/*",
        "!Package/Tag/Sample",
        "!Package/PipeOperator",
        "!Package/EffectCli",
        "!Package/EffectCli/dist",
        "!Package/Listr",
        "!Package/ListrOld",
        "!Template",
        "!Template/**/*",
        "!Package/Listr/**/*",
        "!Package/OraSpinnerDemo",
        "!Development/**/*",
        "!Package/CreateReactiveEvent",
        "Package/ReactiveEvent/Documentation",
        "Package/ReactiveEvent/Documentation/docs",
        "Package/ReactiveEvent/Documentation/landing",
        "!Package/ReactiveEvent/Sample",
        "!Package/ReactiveEvent/Website/Animation",
        "!Package/ReactiveEvent/Sample/**/*",
        "!Package/ReactiveEvent/DocumentationOld",
        "!Package/ReactiveEvent/DocumentationOld/**/*",
        "Documentation",
        "Script/*"
    ],
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "24.13.0",
        "clipboardy": "^5.3.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.4",
        "eslint-plugin-jsdoc": "^62.8.1",
        "eslint-plugin-package-json": "^0.91.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-tsdoc": "^0.5.2",
        "jsonc-eslint-parser": "^3.1.0",
        "ts-node": "^10.9.2",
        "typescript-eslint": "^8.57.2"
    }
